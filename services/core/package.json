{
  "name": "@zordms/core",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "DB_CLIENT=${DB_CLIENT:-sqlite3} DB_NAME=${DB_NAME_CORE:-zordms_core} tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "gen:openapi": "tsx src/openapi/generate.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@zordms/auth": "workspace:*",
    "@zordms/config": "workspace:*",
    "@zordms/db": "workspace:*",
    "@zordms/types": "workspace:*",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
