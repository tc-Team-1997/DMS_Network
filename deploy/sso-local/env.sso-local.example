# =============================================================================
# ZorDMS — LOCAL SSO env (copy the block(s) you want into the gateway env, then
# ./restart.sh). These values target the local harness in this folder
# (docker compose -f deploy/sso-local/docker-compose.yml up -d).
#
# IMPORTANT: enabling SSO is PURELY env. The gateway code is identical in
# dev/UAT/prod — only the values below change per environment (see README
# promotion table). All three providers are independent feature flags; you can
# enable one, two, or all three.
# =============================================================================

# Shared: where OIDC/SAML hand the minted JWT back to (the SPA) + default role
# for first-time (JIT-provisioned) external users.
WEB_APP_URL=http://localhost:5174
SSO_DEFAULT_ROLE=Viewer

# -----------------------------------------------------------------------------
# (1) OIDC  -> Keycloak realm "zordms", confidential client "zordms-web".
#     Open localhost:5174, click the "Single Sign-On" button.
# -----------------------------------------------------------------------------
AUTH_OIDC_ENABLED=true
OIDC_DISPLAY_NAME=Keycloak (OIDC)
OIDC_ISSUER=http://localhost:8080/realms/zordms
OIDC_CLIENT_ID=zordms-web
# Fixed secret from realm-zordms.json (NOT a generated one) so this is copy-pasteable.
OIDC_CLIENT_SECRET=zordms-local-secret-DO-NOT-USE-IN-PROD
OIDC_REDIRECT_URI=http://localhost:4000/auth/oidc/callback
OIDC_SCOPES=openid email profile groups
# Map Keycloak group name -> ZorDMS role. (full.path=false in the realm, so the
# claim contains bare group names like "dms-admins".)
OIDC_GROUP_ROLE_MAP={"dms-admins":"Supervisor","dms-makers":"Maker","dms-checkers":"Checker"}

# -----------------------------------------------------------------------------
# (2) LDAP/AD  -> local OpenLDAP (dc=zordms,dc=local).
#     POST /auth/ldap/login { "username": "sonam.maker", "password": "Password123!" }
# -----------------------------------------------------------------------------
AUTH_LDAP_ENABLED=true
LDAP_DISPLAY_NAME=Corporate LDAP
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=cn=admin,dc=zordms,dc=local
LDAP_BIND_CREDENTIALS=adminpassword
LDAP_SEARCH_BASE=ou=people,dc=zordms,dc=local
# Seed users log in by uid (the local OpenLDAP isn't AD's sAMAccountName).
LDAP_SEARCH_FILTER=(uid={{username}})
LDAP_GROUP_ATTR=memberOf
# memberOf returns full group DNs; map those DNs -> ZorDMS roles.
LDAP_GROUP_ROLE_MAP={"cn=dms-admins,ou=groups,dc=zordms,dc=local":"Supervisor","cn=dms-makers,ou=groups,dc=zordms,dc=local":"Maker","cn=dms-checkers,ou=groups,dc=zordms,dc=local":"Checker"}

# -----------------------------------------------------------------------------
# (3) SAML  -> Keycloak realm "zordms", SAML client. See README for where to copy
#     the IdP signing cert from (Realm Settings -> Keys -> RS256 -> Certificate,
#     or the descriptor at the entry point URL below).
# -----------------------------------------------------------------------------
AUTH_SAML_ENABLED=true
SAML_DISPLAY_NAME=Keycloak (SAML)
SAML_ENTRY_POINT=http://localhost:8080/realms/zordms/protocol/saml
# Must match the SAML client id (SP entityID) in the realm.
SAML_ISSUER=http://localhost:4000/auth/saml/metadata
SAML_CALLBACK_URL=http://localhost:4000/auth/saml/callback
# Paste the realm's SAML signing certificate (base64, single line, no PEM
# headers) here. Fetch it from:
#   http://localhost:8080/realms/zordms/protocol/saml/descriptor
# (copy the <ds:X509Certificate> value) — see README step (e).
SAML_IDP_CERT=
SAML_GROUP_ROLE_MAP={"dms-admins":"Supervisor","dms-makers":"Maker","dms-checkers":"Checker"}
