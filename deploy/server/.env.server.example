# =============================================================================
# ZorDMS server (container) environment template.
# Copy this file to `deploy/server/.env` (same dir as docker-compose.yml).
# `setup_server.sh` does this for you on first run.
# =============================================================================

# ─── Database (PostgreSQL in container) ──────────────────────────────────────
DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_USER=zordms
DB_PASSWORD=zordms
DB_NAME=zordms
# Python AI service uses the SQLAlchemy URL form against the same postgres.
DATABASE_URL=postgresql+psycopg://zordms:zordms@postgres:5432/zordms

# ─── Auth / app ──────────────────────────────────────────────────────────────
# CHANGE THESE for any non-throwaway deployment.
JWT_SECRET=change-me-in-prod
SESSION_SECRET=change-me-in-prod
INTERNAL_SERVICE_TOKEN=change-me-internal
CORS_ORIGIN=http://localhost

# ─── Service URLs (container DNS) ────────────────────────────────────────────
CORE_URL=http://core:4001
AI_URL=http://ai:8080
WORKFLOW_URL=http://workflow:4002
SEARCH_URL=http://search:4004
CORE_INGEST_TIMEOUT_MS=5000

# ─── AI backend ──────────────────────────────────────────────────────────────
# `mock` keeps everything green on CPU-only servers; switch to `vllm` or
# `ollama` once an inference container is reachable on the network.
AI_BACKEND=mock
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_VLM_MODEL=qwen2.5vl:7b
# OLLAMA_TEXT_MODEL=granite3.3:8b

# ─── Search ──────────────────────────────────────────────────────────────────
# `sql` uses the postgres FTS backend; switch to `elasticsearch` to use an ES
# container/cluster reachable at ELASTICSEARCH_NODE.
SEARCH_BACKEND=sql
# ELASTICSEARCH_NODE=http://elasticsearch:9200
# ELASTICSEARCH_INDEX=zordms-documents

# ─── SSO (off by default) ────────────────────────────────────────────────────
AUTH_LDAP_ENABLED=false
AUTH_OIDC_ENABLED=false
AUTH_SAML_ENABLED=false
SSO_DEFAULT_ROLE=Viewer

# ─── Notify (email) ──────────────────────────────────────────────────────────
# Leave SMTP_* unset to use the jsonTransport fallback (writes to logs).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=zordms@example.com

# ─── Integration connectors ─────────────────────────────────────────────────
# Leave unset to use the built-in MOCK connectors.
# CBS_BASE_URL=
# LOS_BASE_URL=
# KYC_BASE_URL=
