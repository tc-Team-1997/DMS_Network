{
  "openapi": "3.1.0",
  "info": {
    "title": "ZorDMS Notify Service API",
    "version": "1.0.0",
    "description": "Alerts and alert-rule management for the ZorDMS platform. All REST and SSE routes require a bearer JWT."
  },
  "servers": [
    {
      "url": "/",
      "description": "notify service root"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT (HS256) bearer token. Claims carry roles/permissions/branch."
      },
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-token",
        "description": "Shared secret for trusted service-to-service calls."
      },
      "hmacSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-signature",
        "description": "HMAC-SHA256 signature of the raw request body for inbound integration webhooks."
      }
    },
    "schemas": {
      "ChannelKey": {
        "type": "string",
        "enum": [
          "email",
          "sms",
          "whatsapp",
          "teams",
          "inapp"
        ],
        "description": "Delivery channel for a notification."
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "meta": {
            "type": "string"
          },
          "is_read": {
            "type": "boolean"
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "level",
          "title",
          "is_read"
        ]
      },
      "Rule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": {}
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "escalationTarget": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "templateKey": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "trigger",
          "params",
          "channels",
          "enabled"
        ]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "validation_error"
            ]
          },
          "issues": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "error",
          "issues"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "required": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "CreateRuleBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable rule name."
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "description": "Domain event type that triggers the rule, e.g. document.expiring."
          },
          "params": {
            "type": "object",
            "additionalProperties": {},
            "description": "Trigger-specific parameters."
          },
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChannelKey"
            },
            "description": "Channels to dispatch on."
          },
          "escalationTarget": {
            "type": [
              "string",
              "null"
            ],
            "description": "Role to escalate to."
          },
          "scope": {
            "type": [
              "string",
              "null"
            ],
            "description": "Branch scope; rule fires only for this branch."
          },
          "templateKey": {
            "type": [
              "string",
              "null"
            ],
            "description": "Email template key to render for the email channel; null = plain title."
          }
        },
        "required": [
          "name",
          "trigger"
        ]
      },
      "UpdateRuleBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object",
            "additionalProperties": {}
          },
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChannelKey"
            }
          },
          "escalationTarget": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "templateKey": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "EscalateBody": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Role name to escalate the alert to."
          }
        },
        "required": [
          "target"
        ]
      },
      "EmailTemplate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject_template": {
            "type": "string"
          },
          "html_body_template": {
            "type": "string"
          },
          "text_body_template": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "created_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "key",
          "name",
          "subject_template",
          "html_body_template",
          "enabled"
        ]
      },
      "CreateEmailTemplateBody": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_]+$",
            "description": "Stable slug used to bind the template to a send site."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable name."
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "description": "Grouping label, e.g. Compliance."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "subjectTemplate": {
            "type": "string",
            "minLength": 1,
            "description": "Subject line; may contain {{tags}}."
          },
          "htmlBodyTemplate": {
            "type": "string",
            "minLength": 1,
            "description": "HTML body with {{merge tags}}."
          },
          "textBodyTemplate": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional plain-text fallback."
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "name",
          "subjectTemplate",
          "htmlBodyTemplate"
        ]
      },
      "UpdateEmailTemplateBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "subjectTemplate": {
            "type": "string",
            "minLength": 1
          },
          "htmlBodyTemplate": {
            "type": "string",
            "minLength": 1
          },
          "textBodyTemplate": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "PreviewEmailTemplateBody": {
        "type": "object",
        "properties": {
          "context": {
            "type": "object",
            "additionalProperties": {},
            "description": "Optional render context; defaults to sample data."
          }
        }
      },
      "TestSendEmailTemplateBody": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "format": "email",
            "description": "Recipient email for the test send."
          },
          "context": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "to"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "OpenAPI 3.1 document for this service",
        "responses": {
          "200": {
            "description": "The OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "List alerts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "critical"
              ]
            },
            "required": false,
            "name": "level",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "unread",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Alert list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "alerts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Alert"
                      }
                    }
                  },
                  "required": [
                    "alerts"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/alerts/stream": {
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "Server-Sent Events stream of live alerts (auth-gated)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream of alert events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/alerts/{id}/read": {
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Mark an alert as read",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Resource identifier (UUID)."
            },
            "required": true,
            "description": "Resource identifier (UUID).",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Marked read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/alerts/{id}/escalate": {
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Escalate an alert to a role",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Resource identifier (UUID)."
            },
            "required": true,
            "description": "Resource identifier (UUID).",
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EscalateBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Escalated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "escalatedTo": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "escalatedTo"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "target required / validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/rules": {
      "get": {
        "tags": [
          "rules"
        ],
        "summary": "List alert rules",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Rule list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rules": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Rule"
                      }
                    }
                  },
                  "required": [
                    "rules"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "rules"
        ],
        "summary": "Create an alert rule",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRuleBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Rule created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/rules/{id}": {
      "patch": {
        "tags": [
          "rules"
        ],
        "summary": "Update an alert rule",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Resource identifier (UUID)."
            },
            "required": true,
            "description": "Resource identifier (UUID).",
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRuleBody"
              }
            }
          }
        },
        "responses": {
