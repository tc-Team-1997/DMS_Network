{
  "openapi": "3.1.0",
  "info": {
    "title": "ZorDMS Integration Service",
    "version": "1.0.0",
    "description": "Integration hub: HMAC-signed inbound webhooks (CBS/LOS/KYC), outbound webhook subscriptions, and connector/management routes. Inbound events are forwarded to core ingest with the x-internal-token service credential."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token for management/outbound routes."
      },
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-token",
        "description": "Shared service-to-service token (INTERNAL_SERVICE_TOKEN). Used by the hub when forwarding verified inbound events to core ingest endpoints."
      },
      "hmacSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-zordms-signature",
        "description": "HMAC-SHA256 signature of the raw request body, formatted 'sha256=<hex>', keyed by the per-system shared secret. Verified against the raw bytes before the body is parsed."
      }
    },
    "schemas": {
      "ValidationError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "validation_error"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message",
                "code"
              ]
            }
          }
        },
        "required": [
          "error",
          "issues"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "CbsCustomerUpdated": {
        "type": "object",
        "properties": {
          "cid": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          }
        },
        "required": [
          "cid"
        ]
      },
      "LosLoanApplication": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "minLength": 1
          },
          "cid": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "applicationId",
          "cid",
          "amount"
        ]
      },
      "KycVerificationResult": {
        "type": "object",
        "properties": {
          "cid": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "REVIEW"
            ]
          }
        },
        "required": [
          "cid",
          "decision"
        ]
      },
      "CreateOutboundWebhook": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "auth_method": {
            "type": "string",
            "enum": [
              "hmac",
              "bearer",
              "none"
            ],
            "default": "hmac"
          },
          "secret": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url",
          "events"
        ],
        "additionalProperties": false
      },
      "TestOutbound": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "event"
        ],
        "additionalProperties": false
      },
      "SetInboundSecret": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "secret"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/cbs/customer-updated": {
      "post": {
        "summary": "Inbound CBS customer-updated webhook (HMAC-signed)",
        "description": "External system -> hub. The raw body is HMAC-verified (x-zordms-signature) before parsing. The verified payload is emitted on the internal bus and, where a route exists, forwarded to core ingest.",
        "security": [
          {
            "hmacSignature": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CbsCustomerUpdated"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "event": {
                      "type": "string"
                    },
                    "consumed": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "accepted",
                    "event",
                    "consumed"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Raw body unavailable or payload failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid HMAC signature",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/los/loan-application": {
      "post": {
        "summary": "Inbound LOS loan-application webhook (HMAC-signed)",
        "description": "External system -> hub. The raw body is HMAC-verified (x-zordms-signature) before parsing. The verified payload is emitted on the internal bus and, where a route exists, forwarded to core ingest.",
        "security": [
          {
            "hmacSignature": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LosLoanApplication"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "event": {
                      "type": "string"
                    },
                    "consumed": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "accepted",
                    "event",
                    "consumed"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Raw body unavailable or payload failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid HMAC signature",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/kyc/verification-result": {
      "post": {
        "summary": "Inbound KYC verification-result webhook (HMAC-signed)",
        "description": "External system -> hub. The raw body is HMAC-verified (x-zordms-signature) before parsing. The verified payload is emitted on the internal bus and, where a route exists, forwarded to core ingest.",
        "security": [
          {
            "hmacSignature": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KycVerificationResult"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "event": {
                      "type": "string"
                    },
                    "consumed": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "accepted",
                    "event",
                    "consumed"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Raw body unavailable or payload failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid HMAC signature",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/outbound": {
      "post": {
        "summary": "Register an outbound webhook subscription",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOutboundWebhook"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webhook": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "events": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "auth_method": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "url",
                        "events",
                        "auth_method"
                      ]
                    }
                  },
                  "required": [
                    "webhook"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Insufficient permission (integration:manage)"
          }
        }
      },
      "get": {
        "summary": "List outbound webhook subscriptions (secrets redacted)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webhooks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "events": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "auth_method": {
                            "type": "string"
                          },
                          "enabled": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "url",
                          "events",
                          "auth_method",
                          "enabled"
                        ]
                      }
                    }
                  },
                  "required": [
                    "webhooks"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          }
        }
      }
    },
    "/outbound/test": {
      "post": {
        "summary": "Dispatch a test event to matching subscriptions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestOutbound"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dispatch report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "report": {}
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Insufficient permission (integration:manage)"
          }
        }
      }
    },
    "/integration/logs": {
      "get": {
        "summary": "List integration call logs",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": false,
            "name": "system",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 200,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "logs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": {}
                      }
                    }
                  },
                  "required": [
                    "logs"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          }
        }
      }
    },
    "/integration/systems": {
      "get": {
        "summary": "List connected systems and their health",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "systems": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": {}
                      }
                    }
                  },
                  "required": [
                    "systems"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          }
        }
      }
    },
    "/integration/systems/{id}/inbound-secret": {
      "put": {
        "summary": "Set or rotate a connected system's inbound HMAC secret",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "System natural key, e.g. cbs"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetInboundSecret"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Secret set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "system": {
                      "type": "string"
                    },
                    "inboundSecretSet": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "system",
                    "inboundSecretSet"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "Insufficient permission (integration:manage)"
          },
          "404": {
            "description": "System not found"
          }
        }
      }
    }
  },
  "webhooks": {}
}
