    "/idp/infer-fields": {
      "post": {
        "summary": "Infer Fields Endpoint",
        "description": "Propose a METADATA FIELD SCHEMA from a SAMPLE document.\n\nAn admin uploads a representative document (image or PDF) and the vision\nmodel proposes the fields to capture for that doc type. The response always\nhas HTTP 200; if the backend is unavailable it returns an empty ``fields``\nlist with ``degraded: true`` and a human ``note`` rather than a 500.\n\nResponse shape::\n\n    {\n      \"doc_type_hint\": str | null,\n      \"fields\": [\n        {\"name\": str, \"label\": str, \"type\": \"string|date|number|enum\",\n         \"mandatory\": bool, \"sample_value\": str},\n        ...\n      ],\n      \"degraded\": bool,\n      \"note\": str | null\n    }",
        "operationId": "infer_fields_endpoint_idp_infer_fields_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_infer_fields_endpoint_idp_infer_fields_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Infer Fields Endpoint Idp Infer Fields Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/idp/seed": {
      "post": {
        "summary": "Seed Endpoint",
        "description": "(Dev) Re-run the review-queue seed; no-op if data already present.\n\nReturns ``{\"inserted\": N}`` where N is the number of rows added (0 = already seeded).\nRequires a valid Bearer JWT like all other /idp/* routes.",
        "operationId": "seed_endpoint_idp_seed_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Seed Endpoint Idp Seed Post"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
