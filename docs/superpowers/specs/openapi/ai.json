    "/ocr": {
      "post": {
        "summary": "Ocr Endpoint",
        "description": "OCR an uploaded image. `lang` defaults to Dzongkha+English (\"dzo+eng\");\nunavailable language packs degrade gracefully (see ocr_text_lang). The\nresponse reports the language actually used so callers can see when Dzongkha\nfell back to English.",
        "operationId": "ocr_endpoint_ocr_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_ocr_endpoint_ocr_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ocr Endpoint Ocr Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
