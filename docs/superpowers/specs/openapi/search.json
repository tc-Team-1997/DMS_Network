{
  "openapi": "3.1.0",
  "info": {
    "title": "ZorDMS Search Service",
    "version": "1.0.0",
    "description": "Full-text & faceted search, saved searches, CSV export and admin reindex for the ZorDMS platform."
  },
  "servers": [
    {
      "url": "/",
      "description": "Search service root"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "User-facing endpoints require a bearer JWT issued by @zordms/auth."
      },
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-internal-token",
        "description": "Shared internal token for service-to-service / integration inbound calls."
      },
      "hmacSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-signature",
        "description": "HMAC signature over the raw request body for integration inbound webhook calls."
      }
    },
    "schemas": {
      "SearchHit": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "doc_type": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "indexed_at": {
            "type": "string"
          }
        },
        "required": [
          "doc_id",
          "doc_type",
          "branch",
          "status",
          "snippet",
          "score",
          "indexed_at"
        ]
      },
      "FacetBucket": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "count": {
            "type": "number"
          }
        },
        "required": [
          "value",
          "count"
        ]
      },
      "SearchResults": {
        "type": "object",
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          },
          "tookMs": {
            "type": "number"
          },
          "facets": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/FacetBucket"
              }
            }
          }
        },
        "required": [
          "hits",
          "total",
          "page",
          "pageSize",
          "tookMs"
        ]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "validation_error"
            ]
          },
          "issues": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "error",
          "issues"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "SearchMode": {
        "type": "string",
        "enum": [
          "fulltext",
          "boolean",
          "wildcard",
          "fuzzy",
          "semantic"
        ]
      },
      "SearchFilters": {
        "type": "object",
        "properties": {
          "doc_type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "uploaded_by": {
            "type": "string"
          },
          "risk_band": {
            "type": "string"
          },
          "legal_hold": {
            "type": "boolean"
          },
          "expiry_status": {
            "type": "string"
          },
          "date_from": {
            "type": "string"
          },
          "date_to": {
            "type": "string"
          }
        }
      },
      "SearchQuery": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/SearchMode"
          },
          "filters": {
            "$ref": "#/components/schemas/SearchFilters"
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "pageSize": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 5000
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "recent"
            ]
          }
        },
        "required": [
          "text",
          "mode"
        ]
      },
      "SavedSearchVisibility": {
        "type": "string",
        "enum": [
          "private",
          "public"
        ]
      },
      "SavedSearch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "query_json": {
            "$ref": "#/components/schemas/SearchQuery"
          },
          "visibility": {
            "$ref": "#/components/schemas/SavedSearchVisibility"
          }
        },
        "required": [
          "id",
          "user_id",
          "name",
          "query_json",
          "visibility"
        ]
      },
      "SaveSearchRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "$ref": "#/components/schemas/SearchQuery"
          },
          "visibility": {
            "$ref": "#/components/schemas/SavedSearchVisibility"
          }
        },
        "required": [
          "name",
          "query"
        ]
      },
      "SearchDoc": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "ocr_text": {
            "type": "string",
            "default": ""
          },
          "metadata_text": {
            "type": "string",
            "default": ""
          },
          "doc_type": {
            "type": "string",
            "default": ""
          },
          "branch": {
            "type": "string",
            "default": ""
          },
          "status": {
            "type": "string",
            "default": ""
          },
          "risk_band": {
            "type": "string",
            "default": ""
          },
          "legal_hold": {
            "type": "boolean",
            "default": false
          },
          "expiry_status": {
            "type": "string",
            "default": ""
          },
          "uploaded_by": {
            "type": "string",
            "default": ""
          },
          "indexed_at": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "doc_id"
        ]
      },
      "ReindexRequest": {
        "type": "object",
        "properties": {
          "docs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchDoc"
            },
            "default": []
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/search": {
      "post": {
        "summary": "Run a search query within the caller's branch scope.",
        "tags": [
          "search"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResults"
                }
              }
            }
          },
          "400": {
            "description": "Request failed boundary validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks document:read permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/facets": {
      "get": {
        "summary": "Return facet dimensions for the caller scope.",
        "tags": [
          "search"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Facet buckets keyed by dimension.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "facets": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/FacetBucket"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks document:read permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/search/export.csv": {
      "post": {
        "summary": "Export search results as CSV (capped at 5000 rows).",
        "tags": [
          "search"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CSV export.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Request failed boundary validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks document:read permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/saved": {
      "post": {
        "summary": "Create a saved search.",
        "tags": [
          "saved-searches"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveSearchRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved search created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedSearch"
                }
              }
            }
          },
          "400": {
            "description": "Request failed boundary validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks document:read permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List the caller's own + public saved searches.",
        "tags": [
          "saved-searches"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Saved searches visible to the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saved": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SavedSearch"
                      }
                    }
                  },
                  "required": [
                    "saved"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks document:read permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/saved/{id}/run": {
      "post": {
        "summary": "Run a previously saved search with the caller's scope.",
        "tags": [
          "saved-searches"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Search results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResults"
                }
              }
            }
          },
          "400": {
            "description": "Request failed boundary validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Saved search not found or not visible to caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Stored query is corrupted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/admin/reindex": {
      "post": {
        "summary": "Reindex a batch of documents.",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "internalToken": [],
            "hmacSignature": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReindexRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Number of documents reindexed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reindexed": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "reindexed"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Request failed boundary validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks admin:access permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Liveness probe.",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "Service healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "backend": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "backend"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
