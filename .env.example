# =============================================================================
# ZorDMS environment template — copy to `.env` and edit for your machine.
# `.env` is gitignored. Never commit secrets to this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Node/Knex layer in packages/db)
# -----------------------------------------------------------------------------
# DB_CLIENT picks the dialect. Valid values:
#   pg        - PostgreSQL (default for dev/prod)
#   oracledb  - Oracle (requires Instant Client + running Oracle)
#   sqlite3   - SQLite (tests only; not for prod)
DB_CLIENT=pg

# Postgres / Oracle connection (ignored when DB_CLIENT=sqlite3)
DB_HOST=localhost
DB_PORT=5432
DB_USER=zordms
DB_PASSWORD=zordms
DB_NAME=zordms

# Oracle-only: used when DB_CLIENT=oracledb
DB_ORACLE_CONNECT_STRING=localhost:1521/ORCLPDB1

# SQLite-only: when DB_CLIENT=sqlite3, DB_NAME is the file path
# DB_CLIENT=sqlite3
# DB_NAME=./packages/db/zordms.dev.db

# -----------------------------------------------------------------------------
# Auth / app
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-prod
SESSION_SECRET=change-me-in-prod
GATEWAY_PORT=4000
# Token required by internal services when calling /authz/check (must match across services)
INTERNAL_SERVICE_TOKEN=change-me-internal
# Allowed CORS origin for the web UI (restrict in production)
CORS_ORIGIN=http://localhost:5174

# -----------------------------------------------------------------------------
# Enterprise SSO (services/gateway) — Bank of Bhutan internal staff
# -----------------------------------------------------------------------------
# Local username/password login is ALWAYS available and is the default. Every
# SSO provider below is independently feature-flagged via its AUTH_*_ENABLED
# flag; a provider is enabled ONLY when its flag is exactly "true". When a
# provider is disabled its routes return 404 {"error":"provider_disabled"} and
# it does not appear in GET /auth/config. SSO is strictly additive.
#
# GET /auth/config (public, no auth) returns:
#   { "local": true,
#     "providers": [ { "id": "ldap"|"oidc"|"saml", "enabled": true,
#                      "displayName": "...", "loginUrl": "/auth/<id>/login" } ] }
# so the login UI renders the right buttons (only enabled providers appear).

# Default local role granted to JIT-provisioned external users (must exist in
# the roles table; "Viewer" is seeded). Authorization always comes from the
# local RBAC tables — the IdP supplies identity only.
SSO_DEFAULT_ROLE=Viewer
# Web app base URL the OIDC/SAML callbacks redirect back to with the minted
# internal JWT in the URL fragment: <WEB_APP_URL>/login#token=<jwt>
# Defaults to CORS_ORIGIN when unset.
# WEB_APP_URL=http://localhost:5174

# ── LDAP / Active Directory ───────────────────────────────────────────────
# POST /auth/ldap/login { username, password } -> binds to AD, issues internal JWT
AUTH_LDAP_ENABLED=false
LDAP_DISPLAY_NAME=Active Directory
LDAP_URL=ldaps://ad.bobl.bt:636
LDAP_BIND_DN=CN=svc-zordms,OU=Service,DC=bobl,DC=bt
LDAP_BIND_CREDENTIALS=change-me
LDAP_SEARCH_BASE=DC=bobl,DC=bt
# {{username}} is substituted with the submitted username
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_GROUP_ATTR=memberOf
# Optional JSON map of IdP group (DN/name) -> local role, e.g.
# LDAP_GROUP_ROLE_MAP={"CN=DMS-Admins,OU=Groups,DC=bobl,DC=bt":"Supervisor","CN=DMS-Makers,OU=Groups,DC=bobl,DC=bt":"Maker"}

# ── OIDC / OAuth2 ─────────────────────────────────────────────────────────
# GET /auth/oidc/login -> IdP (state+nonce+PKCE); GET /auth/oidc/callback -> handoff
AUTH_OIDC_ENABLED=false
OIDC_DISPLAY_NAME=Single Sign-On
OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:4000/auth/oidc/callback
OIDC_SCOPES=openid email profile
# Optional JSON map of IdP group claim -> local role
# OIDC_GROUP_ROLE_MAP={"dms-admins":"Supervisor"}

# ── SAML 2.0 ──────────────────────────────────────────────────────────────
# GET /auth/saml/login -> IdP SSO; POST /auth/saml/callback (ACS) -> handoff
AUTH_SAML_ENABLED=false
SAML_DISPLAY_NAME=Single Sign-On
SAML_ENTRY_POINT=https://idp.bobl.bt/sso
SAML_ISSUER=zordms
# PEM IdP signing certificate (single line or use a secrets manager)
SAML_IDP_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
SAML_CALLBACK_URL=http://localhost:4000/auth/saml/callback
# Optional JSON map of IdP group -> local role
# SAML_GROUP_ROLE_MAP={"dms-admins":"Supervisor"}

# -----------------------------------------------------------------------------
# Search service (services/search)
# -----------------------------------------------------------------------------
# SEARCH_BACKEND selects the full-text engine:
#   sql           - SQL search_index backend (default; zero infra, used in dev/tests)
#   elasticsearch - Elasticsearch backend (alias: "es")
# When "elasticsearch" is selected but ES is UNREACHABLE at boot, the service
# logs a warning and falls back to the SQL backend so it always boots.
SEARCH_BACKEND=sql
# Elasticsearch node URL (used only when SEARCH_BACKEND=elasticsearch).
ELASTICSEARCH_NODE=http://localhost:9200
# Elasticsearch index name for documents.
ELASTICSEARCH_INDEX=zordms-documents
# Optional: HTTP port the search service listens on.
# SEARCH_PORT=4004

# -----------------------------------------------------------------------------
# Document storage (services/core)
# -----------------------------------------------------------------------------
# Backend for document blobs. "local" (default) writes content-addressed files
# under STORAGE_LOCAL_ROOT; "s3" uses an S3/MinIO bucket. If "s3" is selected but
# the bucket/credentials are missing, core logs a degraded warning and falls back
# to local rather than failing boot.
# STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
# S3 / MinIO settings (only read when STORAGE_DRIVER=s3):
# S3_BUCKET=zordms-documents
# S3_ENDPOINT=http://localhost:9000   # set for MinIO / S3-compatible (enables path-style)
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# Document downloads 302-redirect to a presigned S3 GET URL (bypassing the core
# proxy) when the optional presigner is installed:
#   pnpm --filter @zordms/core add @aws-sdk/s3-request-presigner
# If absent, downloads transparently stream through core instead (no config needed).

# -----------------------------------------------------------------------------
# Integration hub (services/integration)
# -----------------------------------------------------------------------------
# Base URL of the CORE service. Verified inbound webhooks are forwarded here
# (POST /integration/customer-upsert, /integration/loan-intake) using
# INTERNAL_SERVICE_TOKEN as the x-internal-token header.
CORE_URL=http://localhost:4001
# Per-forward timeout (ms) for the core ingest call.
CORE_INGEST_TIMEOUT_MS=5000

# Live connector base URLs. When set, the hub uses the HTTP connector for that
# system; when blank/unset it falls back to the built-in MOCK connector.
# CBS_BASE_URL=https://bancs.example.bt/api
# LOS_BASE_URL=https://los.example.bt/api
# KYC_BASE_URL=https://kyc.example.bt/api

# -----------------------------------------------------------------------------
# Python AI service (python-service/)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://zordms:zordms@localhost:5432/zordms

# ── Ollama local inference (Apple Silicon / M-series) ─────────────────────
# Ollama must be running as a brew service: `brew services start ollama`
# Pull models: `ollama pull qwen2.5vl:7b && ollama pull granite3.3:8b`
# AI_BACKEND: auto (default) | ollama | vllm | mock
# AI_BACKEND=auto
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_VLM_MODEL=qwen2.5vl:7b
# OLLAMA_TEXT_MODEL=granite3.3:8b
