# =============================================================================
# ZorDMS environment template — copy to `.env` and edit for your machine.
# `.env` is gitignored. Never commit secrets to this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Node/Knex layer in packages/db)
# -----------------------------------------------------------------------------
# DB_CLIENT picks the dialect. Valid values:
#   pg        - PostgreSQL (default for dev/prod)
#   oracledb  - Oracle (requires Instant Client + running Oracle)
#   sqlite3   - SQLite (tests only; not for prod)
DB_CLIENT=pg

# Postgres / Oracle connection (ignored when DB_CLIENT=sqlite3)
DB_HOST=localhost
DB_PORT=5432
DB_USER=zordms
DB_PASSWORD=zordms
DB_NAME=zordms

# Oracle-only: used when DB_CLIENT=oracledb
DB_ORACLE_CONNECT_STRING=localhost:1521/ORCLPDB1

# SQLite-only: when DB_CLIENT=sqlite3, DB_NAME is the file path
# DB_CLIENT=sqlite3
# DB_NAME=./packages/db/zordms.dev.db

# -----------------------------------------------------------------------------
# Auth / app
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-prod
SESSION_SECRET=change-me-in-prod
GATEWAY_PORT=4000
# Token required by internal services when calling /authz/check (must match across services)
INTERNAL_SERVICE_TOKEN=change-me-internal
# Allowed CORS origin for the web UI (restrict in production)
CORS_ORIGIN=http://localhost:5174

# -----------------------------------------------------------------------------
# Python AI service (python-service/)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://zordms:zordms@localhost:5432/zordms
