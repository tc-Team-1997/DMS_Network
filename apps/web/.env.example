# ZorDMS Web — environment variables
# Copy this file to .env.local (gitignored) and adjust for your environment.
# In development the Vite proxy (vite.config.ts) handles routing, so the
# defaults below work out of the box without needing to set anything.

# ── Service base paths ────────────────────────────────────────────────────────
# These override the proxy-relative defaults defined in src/config.ts.
# Uncomment and set for staging / production deployments.

# VITE_SVC_GATEWAY=/svc/gateway        # Gateway   :4000 (auth / users / authz)
# VITE_SVC_CORE=/svc/core              # Core      :4001 (documents / repository)
# VITE_SVC_WORKFLOW=/svc/workflow      # Workflow  :4002 (workflows / cases)
# VITE_SVC_NOTIFY=/svc/notify          # Notify    :4003 (alerts / notifications)
# VITE_SVC_SEARCH=/svc/search          # Search    :4004 (enterprise search)
# VITE_SVC_INTEGRATION=/svc/integrate  # Integrate :4005 (connectors / hub)
# VITE_SVC_AI=/svc/ai                  # AI        :8000 (OCR / NLP / classify)
# VITE_SVC_AUTH=                       # Auth base (empty = use legacy /auth proxy)
